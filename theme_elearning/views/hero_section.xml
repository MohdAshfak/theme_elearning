<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template Definition -->
    <!-- eLearning style header -->
    <template id="odooelearning_header_add" name="Odoo eLearning Header Add" inherit_id="website.layout">
        <xpath expr="//header" position="inside">
            <div class="elearn-header">
                <div class="container-fluid">
                    <nav class="elearn-navbar d-flex align-items-center justify-content-between">
                        <a t-attf-href="/" class="elearn-brand d-inline-flex align-items-center">
                            <span class="brand-icon d-inline-flex align-items-center justify-content-center">
                                <img src="theme_elearning/static/src/img/eLearning_logo.jpg" alt="Brand Icon"
                                     width="50"
                                     height="50"/>
                            </span>
                            <span class="brand-text">ELearning</span>

                        </a>
                        <ul class="elearn-menu d-none d-lg-flex">
                            <li>
                                <a href="/">Home</a>
                            </li>
                            <li>
                                <a href="/aboutus">About</a>
                            </li>
                            <li>
                                <a href="/coures">Courses</a>
                            </li>
                            <li class="d-none d-md-inline">
                                <a href="/blog">Blog</a>
                            </li>
                            <li>
                                <a href="/contactus">Contact</a>
                            </li>
                        </ul>
                        <div class="elearn-actions d-flex align-items-center gap-2">
                            <a href="/web/login" class="elearn-cta d-none d-lg-inline-flex">Join Now
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     style="margin-left:8px">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </a>
                            <button class="elearn-menu-toggle d-lg-none" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#elearnNav" aria-controls="elearnNav" aria-expanded="false"
                                    aria-label="Toggle navigation">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="3" y1="12" x2="21" y2="12"></line>
                                    <line x1="3" y1="6" x2="21" y2="6"></line>
                                    <line x1="3" y1="18" x2="21" y2="18"></line>
                                </svg>
                            </button>
                        </div>
                    </nav>
                    <div class="collapse d-lg-none" id="elearnNav">
                        <ul class="elearn-menu mobile">
                            <li>
                                <a href="/">Home</a>
                            </li>
                            <li>
                                <a href="/aboutus">About</a>
                            </li>
                            <li>
                                <a href="/coures">Courses</a>
                            </li>
                            <li>
                                <a href="/blog">Blog</a>
                            </li>
                            <li>
                                <a href="/contactus">Contact</a>
                            </li>
                            <li>
                                <a class="elearn-cta w-100 justify-content-center" href="/web/login">Join Now</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Home Page Banner Section (eLearning style hero) -->
