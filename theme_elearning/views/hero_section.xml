                                </a>
                                <a class="btn btn-outline-light btn-social" href="#">
                                    <i class="fa fa-linkedin-square"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h4 class="text-white mb-3">Gallery</h4>
                            <div class="row g-2 pt-2">
                                <div class="col-4">
                                    <img class="img-fluid bg-light p-1"
