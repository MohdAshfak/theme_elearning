                    <div class="container-fluid p-0 mb-5">
                        <div class="carousel-viewport">
                            <div class="carousel-track">
                                <!-- Slide 1 -->
                                <div class="carousel-slide">
                                    <img class="slide-image" src="theme_elearning/static/src/img/carousel-1.jpg"
                                         alt="Slide 1"/>
                                    <div class="slide-overlay">
                                        <div class="container">
                                            <div class="row justify-content-start">
                                                <div class="col-sm-10 col-lg-8">
                                                    <h5 class="text-uppercase mb-3" style="color: #5de3f2;">Best Online
                                                        Courses
                                                    </h5>
                                                    <h1 class="display-3 text-white">The Best Online Learning Platform
                                                    </h1>
                                                    <p class="fs-5 text-white mb-4 pb-2">Vero elitr justo clita lorem.
                                                        Ipsum dolor at sed stet sit diam no.Ipsum dolor at sed stet sit diam
                                                    </p>
                                                    <a href="/blog"
                                                       class="btn btn-primary py-md-3 px-md-5 me-3">Read More
                                                    </a>
                                                    <a href="/web/login" class="btn btn-light py-md-3 px-md-5">Join
                                                        Now
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Slide 2 -->
                                <div class="carousel-slide">
                                    <img class="slide-image" src="theme_elearning/static/src/img/carousel-2.jpg"
                                         alt="Slide 2"/>
                                    <div class="slide-overlay">
                                        <div class="container">
                                            <div class="row justify-content-start">
                                                <div class="col-sm-10 col-lg-8">
                                                    <h5 class="text-uppercase mb-3" style="color: #5de3f2;">Best Online
                                                        Courses
                                                    </h5>
                                                    <h1 class="display-3 text-white">Get Educated Online From Your
                                                        Home
                                                    </h1>
                                                    <p class="fs-5 text-white mb-4 pb-2">Vero elitr justo clita lorem.
                                                        Ipsum dolor at sed stet sit diam no.Ipsum dolor at sed stet sit diam
                                                    </p>
                                                    <a href="/blog"
                                                       class="btn btn-primary py-md-3 px-md-5 me-3">Read More
                                                    </a>
                                                    <a href="/web/login" class="btn btn-light py-md-3 px-md-5">Join
                                                        Now
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Nav -->
                            <button class="carousel-nav prev" aria-label="Previous">‹</button>
                            <button class="carousel-nav next" aria-label="Next">›</button>
                            <div class="carousel-dots" aria-label="Slide navigation"></div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Custom Footer: Replace website footer with provided design -->
